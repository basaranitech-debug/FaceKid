@{
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-body text-center">
            <i class="bi bi-person-circle" style="font-size: 80px;">  
            </i>

            <h3 class="mt-3">@Model.FullName</h3>

            <p class="text-muted">
                @Model.Email
